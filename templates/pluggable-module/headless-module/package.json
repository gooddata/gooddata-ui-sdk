{
    "name": "gdc-headless-template-name-module",
    "version": "11.69.0-alpha.0",
    "private": true,
    "description": "{applicationTemplateTitle} headless module",
    "license": "UNLICENSED",
    "author": {
        "name": "Stellar",
        "email": "stellar@gooddata.com"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/gooddata/gdc-ui/",
        "directory": "modules/gdc-headless-template-name/module"
    },
    "type": "module",
    "sideEffects": false,
    "types": "./src/index.ts",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "source": "./src/index.ts",
            "default": "./src/index.ts"
        },
        "./tsconfig.json": "./tsconfig.json"
    },
    "scripts": {
        "_phase:build": "npm run build-check",
        "_phase:test": "npm run test-once",
        "_phase:validate": "npm run validate",
        "build": "npm-run-all -p build-check dist",
        "build-check": "tsc",
        "clean": "../../../../common/scripts/clean-command-state.sh && rm -rf esm dist *.tgz *.log tsconfig.tsbuildinfo",
        "dev": "vite build && npm-run-all --parallel dev:build dev:serve",
        "dev:build": "vite build --watch",
        "dev:serve": "vite preview",
        "dist": "vite build",
        "format-check": "oxfmt --check .",
        "format-write": "oxfmt .",
        "lint": "oxlint . --quiet && eslint .",
        "lint-fix": "oxlint . --quiet --fix && eslint . --fix",
        "test-once": "vitest run",
        "validate": "npm run lint && npm run format-check"
    },
    "dependencies": {
        "@gooddata/sdk-pluggable-application-model": "workspace:*"
    },
    "devDependencies": {
        "@gooddata/eslint-config": "workspace:*",
        "@gooddata/oxlint-config": "workspace:*",
        "@module-federation/vite": "1.23.9",
        "@types/node": "24.12.0",
        "@typescript-eslint/eslint-plugin": "8.58.0",
        "@typescript-eslint/parser": "8.58.0",
        "eslint": "^10.14.0",
        "eslint-plugin-headers": "1.3.3",
        "eslint-plugin-import-esm": "3.0.1",
        "eslint-plugin-jsdoc": "65.4.2",
        "eslint-plugin-no-barrel-files": "1.2.2",
        "eslint-plugin-no-only-tests": "3.3.0",
        "eslint-plugin-sonarjs": "4.2.2",
        "jiti": "2.6.1",
        "npm-run-all": "4.1.5",
        "oxfmt": "0.68.0",
        "oxlint": "1.83.0",
        "oxlint-plugin-eslint": "1.82.0",
        "oxlint-tsgolint": "7.0.2001",
        "rolldown": "1.2.14",
        "typescript": "7.0.2",
        "vite": "8.3.5",
        "vitest": "5.0.4"
    }
}
