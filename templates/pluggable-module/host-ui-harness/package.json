{
    "name": "gdc-host-ui-template-name-harness",
    "version": "11.68.0-alpha.9",
    "private": true,
    "description": "Standalone harness for gdc-host-ui-template-name module",
    "license": "UNLICENSED",
    "author": {
        "name": "Stellar",
        "email": "stellar@gooddata.com"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/gooddata/gdc-ui/",
        "directory": "modules/gdc-host-ui-template-name/harness"
    },
    "type": "module",
    "exports": {
        "./tsconfig.json": "./tsconfig.json"
    },
    "scripts": {
        "_phase:build": "npm run build-check",
        "_phase:validate": "npm run validate",
        "build": "rm -rf dist && npm-run-all -p dist build-check",
        "build-check": "tsc",
        "clean": "../../../../common/scripts/clean-command-state.sh && rm -rf dist *.tgz *.log tsconfig.tsbuildinfo",
        "dev": "vite --force",
        "dist": "vite build",
        "format-check": "oxfmt --check .",
        "format-write": "oxfmt .",
        "lint": "oxlint . --quiet && eslint .",
        "lint-fix": "oxlint . --quiet --fix && eslint . --fix",
        "validate": "npm run lint && npm run format-check"
    },
    "dependencies": {
        "@gooddata/sdk-model": "workspace:*",
        "@gooddata/sdk-pluggable-application-model": "workspace:*",
        "@gooddata/sdk-ui-kit": "workspace:*",
        "@gooddata/sdk-ui-pluggable-host": "workspace:*",
        "gdc-host-ui-template-name-module": "workspace:*",
        "react": "19.1.1",
        "react-dom": "19.1.1",
        "react-intl": "10.1.25",
        "react-router": "7.18.5"
    },
    "devDependencies": {
        "@gooddata/eslint-config": "workspace:*",
        "@gooddata/oxlint-config": "workspace:*",
        "@types/node": "24.12.0",
        "@types/react": "19.1.11",
        "@types/react-dom": "19.1.7",
        "@typescript-eslint/eslint-plugin": "8.58.0",
        "@typescript-eslint/parser": "8.58.0",
        "@vitejs/plugin-react": "6.0.5",
        "eslint": "^10.14.0",
        "eslint-plugin-headers": "1.3.3",
        "eslint-plugin-jsdoc": "65.4.2",
        "eslint-plugin-no-barrel-files": "1.2.2",
        "eslint-plugin-sonarjs": "4.2.2",
        "eslint-plugin-tsdoc": "0.5.4",
        "jiti": "2.6.1",
        "npm-run-all": "4.1.5",
        "oxfmt": "0.68.0",
        "oxlint": "1.83.0",
        "oxlint-plugin-eslint": "1.82.0",
        "oxlint-tsgolint": "7.0.2001",
        "rolldown": "1.2.14",
        "sass": "1.104.1",
        "typescript": "7.0.2",
        "vite": "8.3.5"
    }
}
