{
    "name": "@gooddata/sdk-maql-language-server",
    "version": "11.65.0-alpha.7",
    "license": "MIT",
    "author": {
        "name": "Stellar",
        "email": "stellar@gooddata.com"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/gooddata/gooddata-ui-sdk.git",
        "directory": "libs/sdk-maql-language-server"
    },
    "files": [
        "esm",
        "README.md"
    ],
    "type": "module",
    "browser": "esm/index.js",
    "types": "esm/index.d.ts",
    "exports": "./esm/index.js",
    "scripts": {
        "_phase:build": "npm run build",
        "_phase:test": "npm run test-once",
        "_phase:validate": "npm run validate",
        "api-extractor": "mkdir -p api && [ -z \"${CI}\" ] && (api-extractor run -l) || (api-extractor run)",
        "build": "npm-run-all -p build-check build-ts && npm run api-extractor",
        "build-check": "tsc",
        "build-ts": "tsc -p ./tsconfig.build.json",
        "clean": "../../common/scripts/clean-command-state.sh && rm -rf esm *.log",
        "format-check": "oxfmt --check .",
        "format-write": "oxfmt .",
        "lint": "oxlint . --quiet && eslint .",
        "lint-fix": "oxlint . --quiet --fix && eslint . --fix",
        "test": "vitest watch",
        "test-once": "vitest run",
        "update-docs": "tsc -p ./scripts && node scripts/build/docsParser.js src/docs",
        "validate": "npm run lint && npm run format-check",
        "validate-esm": "node --input-type=module --eval 'import \"@gooddata/sdk-maql-language-server\"'",
        "watch": "tsc -watch -p ./tsconfig.build.json"
    },
    "dependencies": {
        "@gooddata/maql-antlr4ts": "0.5.1-02977c25.0",
        "@gooddata/sdk-backend-base": "workspace:*",
        "@gooddata/sdk-backend-spi": "workspace:*",
        "@gooddata/sdk-backend-tiger": "workspace:*",
        "@gooddata/sdk-model": "workspace:*",
        "antlr4-c3": "1.1.16",
        "antlr4ts": "0.5.0-alpha.4",
        "assert": "2.1.0",
        "lodash-es": "^4.17.23",
        "util": "0.12.5",
        "vscode-languageserver": "8.1.0",
        "vscode-languageserver-textdocument": "1.0.12"
    },
    "devDependencies": {
        "@gooddata/api-client-tiger": "workspace:*",
        "@gooddata/eslint-config": "workspace:*",
        "@gooddata/oxlint-config": "workspace:*",
        "@gooddata/stylelint-config": "workspace:*",
        "@microsoft/api-documenter": "7.30.16",
        "@microsoft/api-extractor": "7.59.2",
        "@types/lodash-es": "4.17.12",
        "@types/node": "24.12.0",
        "@typescript-eslint/eslint-plugin": "8.58.0",
        "@typescript-eslint/parser": "8.58.0",
        "colors": "1.4.0",
        "eslint": "^9.39.2",
        "eslint-plugin-headers": "1.3.3",
        "eslint-plugin-import-esm": "1.2.1",
        "eslint-plugin-jsdoc": "62.1.0",
        "eslint-plugin-no-barrel-files": "1.2.2",
        "eslint-plugin-no-only-tests": "3.3.0",
        "eslint-plugin-regexp": "1.15.0",
        "eslint-plugin-sonarjs": "3.0.6",
        "eslint-plugin-tsdoc": "0.2.14",
        "glob": "13.0.2",
        "jiti": "2.6.1",
        "npm-run-all": "4.1.5",
        "oxfmt": "0.68.0",
        "oxlint": "1.83.0",
        "oxlint-plugin-eslint": "1.82.0",
        "oxlint-tsgolint": "7.0.2001",
        "process": "0.11.10",
        "ts-dedent": "2.3.0",
        "typescript": "7.0.2",
        "vitest": "5.0.4"
    }
}
