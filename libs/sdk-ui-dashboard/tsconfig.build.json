{
    "extends": "../tsconfig.react.json",
    "exclude": [
        "**/test",
        "**/tests",
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.test.helpers.ts",
        "**/*.test.helpers.tsx",
        "**/*.fixture.ts"
    ],
    "include": ["src/**/*"],
    "compilerOptions": {
        "noCheck": true,
        "rootDir": "./src",
        "outDir": "./esm",
        "composite": false
    }
}
