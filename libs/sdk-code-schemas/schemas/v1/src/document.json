{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Document V2 Type",
    "description": "JSON schema for Gooddata Analytics Document, content version 2",
    "allOf": [
        {
            "if": {
                "properties": {
                    "type": {
                        "const": "document"
                    }
                },
                "required": ["type"]
            },
            "then": {
                "$ref": "#/$defs/publisherDocumentV2"
            }
        }
    ],
    "properties": {
        "type": {
            "type": "string",
            "enum": ["document"]
        }
    },
    "required": ["type"],
    "$defs": {
        "publisherDocumentV2": {
            "$id": "/gaac/publisherDocumentV2",
            "title": "Publisher Document V2",
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "id": {
                    "type": "string",
                    "pattern": "^(?!default\\.)(?!\\.)[.A-Za-z0-9_-]{1,255}$",
                    "description": "A unique identifier of the document. Ids starting with default. are reserved.",
                    "$semantic": [
                        {
                            "type": "uniqueness",
                            "source": "document.id",
                            "code": "core.uniqueness.documents.id"
                        },
                        {
                            "type": "definition",
                            "source": "document.id"
                        }
                    ]
                },
                "type": {
                    "type": "string",
                    "enum": ["document"]
                },
                "version": {
                    "type": "string",
                    "enum": ["2"],
                    "description": "Version of the content format."
                },
                "title": {
                    "$ref": "/gaac/publisherEntityTitleV2"
                },
                "description": {
                    "$ref": "/gaac/publisherEntityDescriptionV2"
                },
                "tags": {
                    "$ref": "/gaac/publisherEntityTagsV2"
                },
                "period": {
                    "$ref": "/gaac/publisherPeriodV2"
                },
                "content": {
                    "$ref": "/gaac/publisherDocumentContentV2"
                }
            },
            "required": ["id", "type", "version", "title", "period", "content"],
            "$semantic": {
                "type": "snippet",
                "snippets": ["document"]
            },
            "not": {
                "$comment": "Only a document template sets content.defaults.period. Each level states type: object, because a value that is not an object satisfies required and properties, so the rule would also fire on it.",
                "type": "object",
                "required": ["content"],
                "properties": {
                    "content": {
                        "type": "object",
                        "required": ["defaults"],
                        "properties": {
                            "defaults": {
                                "type": "object",
                                "required": ["period"]
                            }
                        }
                    }
                }
            }
        },
        "publisherPeriodV2": {
            "$id": "/gaac/publisherPeriodV2",
            "title": "Publisher Period V2",
            "description": "The period the document reports on, in the date filter grammar without a dataset. Numbers for from and to make it relative; dates make it absolute. Both ends are inclusive.",
            "oneOf": [
                {
                    "title": "Publisher Relative Period V2",
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "granularity": {
                            "type": "string",
                            "enum": [
                                "SECOND",
                                "MINUTE",
                                "HOUR",
                                "DAY",
                                "WEEK",
                                "WEEK_US",
                                "MONTH",
                                "QUARTER",
                                "YEAR",
                                "FISCAL_YEAR",
                                "FISCAL_QUARTER",
                                "FISCAL_MONTH"
                            ]
                        },
                        "from": {
                            "type": "integer",
                            "description": "Offset from the current period, for example -1."
                        },
                        "to": {
                            "type": "integer",
                            "description": "Offset from the current period, for example -1."
                        }
                    },
                    "required": ["granularity", "from", "to"]
                },
                {
                    "title": "Publisher Absolute Period V2",
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "from": {
                            "type": "string",
                            "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$",
                            "description": "YYYY-MM-DD."
                        },
                        "to": {
                            "type": "string",
                            "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$",
                            "description": "YYYY-MM-DD."
                        }
                    },
                    "required": ["from", "to"]
                }
            ]
        },
        "publisherDocumentPageV2": {
            "$id": "/gaac/publisherDocumentPageV2",
            "title": "Publisher Document Page V2",
            "type": "object",
            "additionalProperties": false,
            "description": "A page of a document.",
            "properties": {
                "id": {
                    "$ref": "/gaac/publisherPageNodeIdV2",
                    "description": "Unique within the document."
                },
                "visible": {
                    "type": "boolean",
                    "description": "Defaults to true. A hidden page is left out of the viewer, exports and page numbers."
                },
                "kind": {
                    "type": "string",
                    "enum": ["cover", "section", "content"],
                    "description": "Editor hint. It does not change how the page renders."
                },
                "page_size": {
                    "$ref": "/gaac/publisherPageSizeV2"
                },
                "notes": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Markdown speaker notes, never drawn on the page."
                },
                "style": {
                    "$ref": "/gaac/publisherPageStyleV2"
                },
                "layout": {
                    "$ref": "/gaac/publisherLayoutNodeV2",
                    "description": "Root of the page layout tree."
                },
                "filters": {
                    "$ref": "/gaac/dashboardFilters",
                    "description": "Page filters, applied on top of the document filters."
                }
            },
            "required": ["id", "layout"],
            "$comment": "The keys are a page body's plus id and visible. JSON Schema cannot extend the closed /gaac/publisherPageBodyV2, so a key added there belongs here too."
        },
        "publisherSectionV2": {
            "$id": "/gaac/publisherSectionV2",
            "title": "Publisher Section V2",
            "type": "object",
            "additionalProperties": false,
            "description": "A named group of pages.",
            "properties": {
                "id": {
                    "$ref": "/gaac/publisherPageNodeIdV2",
                    "description": "Unique within the document."
                },
                "title": {
                    "type": "string",
                    "minLength": 1
                },
                "description": {
                    "type": "string",
                    "minLength": 1
                },
                "pages": {
                    "type": "array",
                    "items": {
                        "$ref": "/gaac/publisherDocumentPageV2"
                    }
                }
            },
            "required": ["id", "pages"]
        },
        "publisherDocumentDefaultsV2": {
            "$id": "/gaac/publisherDocumentDefaultsV2",
            "title": "Publisher Document Defaults V2",
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "page_size": {
                    "$ref": "/gaac/publisherPageSizeV2",
                    "description": "Applies to every page without its own page_size."
                },
                "takeaway": {
                    "title": "Publisher Document Takeaway Defaults V2",
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "generation": {
                            "$ref": "/gaac/publisherTakeawayGenerationV2",
                            "description": "Combined with each takeaway widget's own generation."
                        }
                    }
                },
                "period": {
                    "$ref": "/gaac/publisherPeriodV2",
                    "description": "Document templates only: the period a document created from the template starts with."
                }
            }
        },
        "publisherDocumentStyleV2": {
            "$id": "/gaac/publisherDocumentStyleV2",
            "title": "Publisher Document Style V2",
            "type": "object",
            "additionalProperties": false,
            "description": "Style of the area behind the pages. Exports ignore it.",
            "properties": {
                "background_color": {
                    "$ref": "/gaac/publisherColorValueV2"
                },
                "background_opacity": {
                    "$ref": "/gaac/publisherOpacityV2"
                },
                "background_image": {
                    "$ref": "/gaac/publisherImageSourceV2"
                },
                "background_image_opacity": {
                    "$ref": "/gaac/publisherOpacityV2"
                },
                "background_fit": {
                    "type": "string",
                    "enum": ["cover", "contain", "fill", "tile"]
                },
                "background_horizontal_align": {
                    "$ref": "/gaac/publisherHorizontalAlignV2"
                },
                "background_vertical_align": {
                    "$ref": "/gaac/publisherVerticalAlignV2"
                },
                "background_offset": {
                    "$ref": "/gaac/publisherPxV2"
                },
                "background_offset_top": {
                    "$ref": "/gaac/publisherPxV2"
                },
                "background_offset_right": {
                    "$ref": "/gaac/publisherPxV2"
                },
                "background_offset_bottom": {
                    "$ref": "/gaac/publisherPxV2"
                },
                "background_offset_left": {
                    "$ref": "/gaac/publisherPxV2"
                },
                "gap": {
                    "$ref": "/gaac/publisherGapValueV2",
                    "description": "Space between pages in the viewer and the editor."
                }
            }
        },
        "publisherDocumentContentV2": {
            "$id": "/gaac/publisherDocumentContentV2",
            "title": "Publisher Document Content V2",
            "type": "object",
            "additionalProperties": false,
            "description": "Holds exactly one of pages and sections.",
            "properties": {
                "defaults": {
                    "$ref": "/gaac/publisherDocumentDefaultsV2"
                },
                "filters": {
                    "$ref": "/gaac/dashboardFilters",
                    "description": "Document filters. Date filters name their date dataset. At most one filter per attribute or date dataset."
                },
                "style": {
                    "$ref": "/gaac/publisherDocumentStyleV2"
                },
                "locale": {
                    "$ref": "/gaac/locale",
                    "description": "Overrides the workspace locale for this document."
                },
                "format_locale": {
                    "$ref": "/gaac/locale",
                    "description": "Overrides the workspace format locale used for dates."
                },
                "pages": {
                    "type": "array",
                    "items": {
                        "$ref": "/gaac/publisherDocumentPageV2"
                    }
                },
                "sections": {
                    "type": "array",
                    "items": {
                        "$ref": "/gaac/publisherSectionV2"
                    }
                }
            },
            "not": {
                "$comment": "Rejects both and neither. type: object, because a value that is not an object satisfies required, so the rule would also fire on it.",
                "type": "object",
                "anyOf": [
                    {
                        "required": ["pages", "sections"]
                    },
                    {
                        "not": {
                            "anyOf": [
                                {
                                    "required": ["pages"]
                                },
                                {
                                    "required": ["sections"]
                                }
                            ]
                        }
                    }
                ]
            }
        }
    }
}
