{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "ParameterType",
    "description": "JSON schema for Gooddata Analytics Parameter",
    "allOf": [
        {
            "if": {
                "properties": {
                    "type": {
                        "const": "parameter"
                    }
                },
                "required": ["type"]
            },
            "then": {
                "$ref": "#/$defs/parameter"
            }
        }
    ],
    "properties": {
        "type": {
            "type": "string",
            "enum": ["parameter"]
        }
    },
    "required": ["type"],
    "$defs": {
        "parameter": {
            "$id": "/gaac/parameter",
            "title": "Parameter",
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "id": {
                    "$ref": "/gaac/identifier",
                    "description": "A unique identifier of the parameter.",
                    "$semantic": [
                        {
                            "type": "uniqueness",
                            "source": "parameter.id",
                            "code": "core.uniqueness.parameters.id"
                        },
                        {
                            "type": "definition",
                            "source": "parameter.id"
                        }
                    ]
                },
                "type": {
                    "type": "string",
                    "enum": ["parameter"]
                },
                "title": {
                    "$ref": "/gaac/title",
                    "description": "An optional human readable title for the parameter. Will be derived from id if not provided explicitly."
                },
                "description": {
                    "$ref": "/gaac/description",
                    "description": "An optional description of the parameter."
                },
                "tags": {
                    "$ref": "/gaac/tags",
                    "description": "A list of strings - metadata tags of this parameter."
                },
                "definition": {
                    "$ref": "#/$defs/parameterDefinition",
                    "description": "The typed definition of the parameter - its data type, default value and constraints."
                }
            },
            "$semantic": {
                "type": "snippet",
                "snippets": ["parameter"]
            },
            "required": ["id", "type", "definition"]
        },
        "parameterDefinition": {
            "title": "Parameter Definition",
            "description": "A typed parameter definition: textual, numeric or a date range.",
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "STRING"
                            }
                        },
                        "required": ["type"]
                    },
                    "then": {
                        "$ref": "#/$defs/stringParameterDefinition"
                    }
                },
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "NUMBER"
                            }
                        },
                        "required": ["type"]
                    },
                    "then": {
                        "$ref": "#/$defs/numberParameterDefinition"
                    }
                },
                {
                    "if": {
                        "properties": {
                            "type": {
                                "const": "DATE_RANGE"
                            }
                        },
                        "required": ["type"]
                    },
                    "then": {
                        "$ref": "#/$defs/dateRangeParameterDefinition"
                    }
                }
            ],
            "properties": {
                "type": {
                    "type": "string",
                    "enum": ["STRING", "NUMBER", "DATE_RANGE"]
                }
            },
            "required": ["type"]
        },
        "dateRangeParameterDefinition": {
            "title": "Date Range Parameter Definition",
            "description": "A named period: a range of whole periods of one granularity. A date filter that uses the parameter filters by its current range.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "type": {
                    "type": "string",
                    "enum": ["DATE_RANGE"]
                },
                "defaultValue": {
                    "$ref": "#/$defs/dateRangeParameterValue",
                    "description": "The range used whenever the parameter is not overridden."
                }
            },
            "required": ["type", "defaultValue"],
            "$semantic": {
                "type": "parameter_constraints"
            }
        },
        "dateRangeParameterValue": {
            "title": "Date Range Parameter Value",
            "description": "A range of whole periods. At least one of 'from' and 'to' is set; a missing one leaves that end open.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "granularity": {
                    "type": "string",
                    "enum": ["YEAR", "QUARTER", "MONTH", "WEEK", "DAY", "HOUR", "MINUTE", "SECOND"],
                    "description": "The unit of 'from' and 'to'."
                },
                "from": {
                    "type": ["string", "integer"],
                    "description": "The first period, inclusive, in the format of the granularity: YYYY, YYYY-Q, YYYY-MM, YYYY-WW (ISO week), YYYY-MM-DD, YYYY-MM-DD HH, YYYY-MM-DD HH:mm or YYYY-MM-DD HH:mm:ss."
                },
                "to": {
                    "type": ["string", "integer"],
                    "description": "The last period, inclusive, in the same format as 'from'."
                }
            },
            "required": ["granularity"],
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "granularity": {
                                "const": "YEAR"
                            }
                        },
                        "required": ["granularity"]
                    },
                    "then": {
                        "title": "Year Period",
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "granularity": {
                                "type": "string",
                                "enum": ["YEAR"]
                            },
                            "from": {
                                "type": ["string", "integer"],
                                "pattern": "^[0-9]{4}$",
                                "minimum": 1000,
                                "maximum": 9999,
                                "description": "The first year, inclusive: YYYY, with or without quotes."
                            },
                            "to": {
                                "type": ["string", "integer"],
                                "pattern": "^[0-9]{4}$",
                                "minimum": 1000,
                                "maximum": 9999,
                                "description": "The last year, inclusive: YYYY, with or without quotes."
                            }
                        },
                        "required": ["granularity"]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "granularity": {
                                "const": "QUARTER"
                            }
                        },
                        "required": ["granularity"]
                    },
                    "then": {
                        "title": "Quarter Period",
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "granularity": {
                                "type": "string",
                                "enum": ["QUARTER"]
                            },
                            "from": {
                                "type": "string",
                                "pattern": "^[0-9]{4}-[0-9]$",
                                "description": "The first quarter, inclusive: YYYY-Q."
                            },
                            "to": {
                                "type": "string",
                                "pattern": "^[0-9]{4}-[0-9]$",
                                "description": "The last quarter, inclusive: YYYY-Q."
                            }
                        },
                        "required": ["granularity"]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "granularity": {
                                "const": "MONTH"
                            }
                        },
                        "required": ["granularity"]
                    },
                    "then": {
                        "title": "Month Period",
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "granularity": {
                                "type": "string",
                                "enum": ["MONTH"]
                            },
                            "from": {
                                "type": "string",
                                "pattern": "^[0-9]{4}-[0-9]{2}$",
                                "description": "The first month, inclusive: YYYY-MM."
                            },
                            "to": {
                                "type": "string",
                                "pattern": "^[0-9]{4}-[0-9]{2}$",
                                "description": "The last month, inclusive: YYYY-MM."
                            }
                        },
                        "required": ["granularity"]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "granularity": {
                                "const": "WEEK"
                            }
                        },
                        "required": ["granularity"]
                    },
                    "then": {
                        "title": "Week Period",
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "granularity": {
                                "type": "string",
                                "enum": ["WEEK"]
                            },
                            "from": {
                                "type": "string",
                                "pattern": "^[0-9]{4}-[0-9]{2}$",
                                "description": "The first week, inclusive: YYYY-WW, an ISO week."
                            },
                            "to": {
                                "type": "string",
                                "pattern": "^[0-9]{4}-[0-9]{2}$",
                                "description": "The last week, inclusive: YYYY-WW, an ISO week."
                            }
                        },
                        "required": ["granularity"]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "granularity": {
                                "const": "DAY"
                            }
                        },
                        "required": ["granularity"]
                    },
                    "then": {
                        "title": "Day Period",
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "granularity": {
                                "type": "string",
                                "enum": ["DAY"]
                            },
                            "from": {
                                "type": "string",
                                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                                "description": "The first day, inclusive: YYYY-MM-DD."
                            },
                            "to": {
                                "type": "string",
                                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                                "description": "The last day, inclusive: YYYY-MM-DD."
                            }
                        },
                        "required": ["granularity"]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "granularity": {
                                "const": "HOUR"
                            }
                        },
                        "required": ["granularity"]
                    },
                    "then": {
                        "title": "Hour Period",
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "granularity": {
                                "type": "string",
                                "enum": ["HOUR"]
                            },
                            "from": {
                                "type": "string",
                                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}$",
                                "description": "The first hour, inclusive: YYYY-MM-DD HH."
                            },
                            "to": {
                                "type": "string",
                                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}$",
                                "description": "The last hour, inclusive: YYYY-MM-DD HH."
                            }
                        },
                        "required": ["granularity"]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "granularity": {
                                "const": "MINUTE"
                            }
                        },
                        "required": ["granularity"]
                    },
                    "then": {
                        "title": "Minute Period",
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "granularity": {
                                "type": "string",
                                "enum": ["MINUTE"]
                            },
                            "from": {
                                "type": "string",
                                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}$",
                                "description": "The first minute, inclusive: YYYY-MM-DD HH:mm."
                            },
                            "to": {
                                "type": "string",
                                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}$",
                                "description": "The last minute, inclusive: YYYY-MM-DD HH:mm."
                            }
                        },
                        "required": ["granularity"]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "granularity": {
                                "const": "SECOND"
                            }
                        },
                        "required": ["granularity"]
                    },
                    "then": {
                        "title": "Second Period",
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "granularity": {
                                "type": "string",
                                "enum": ["SECOND"]
                            },
                            "from": {
                                "type": "string",
                                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}$",
                                "description": "The first second, inclusive: YYYY-MM-DD HH:mm:ss."
                            },
                            "to": {
                                "type": "string",
                                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}$",
                                "description": "The last second, inclusive: YYYY-MM-DD HH:mm:ss."
                            }
                        },
                        "required": ["granularity"]
                    }
                }
            ]
        },
        "numberParameterDefinition": {
            "title": "Number Parameter Definition",
            "description": "A numeric parameter definition. Without 'constraints' the parameter accepts any number.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "type": {
                    "type": "string",
                    "enum": ["NUMBER"]
                },
                "defaultValue": {
                    "type": "number",
                    "description": "The value used whenever the parameter is not overridden."
                },
                "constraints": {
                    "title": "Number Parameter Constraints",
                    "type": "object",
                    "additionalProperties": false,
                    "description": "Optional bounds the parameter value must satisfy.",
                    "properties": {
                        "min": {
                            "type": "number",
                            "description": "The smallest accepted value, inclusive."
                        },
                        "max": {
                            "type": "number",
                            "description": "The largest accepted value, inclusive."
                        }
                    }
                }
            },
            "required": ["type", "defaultValue"],
            "$semantic": {
                "type": "parameter_constraints"
            }
        },
        "stringParameterDefinition": {
            "title": "String Parameter Definition",
            "description": "A textual parameter definition. Without 'constraints' the parameter accepts any free-text value.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "type": {
                    "type": "string",
                    "enum": ["STRING"]
                },
                "defaultValue": {
                    "type": "string",
                    "description": "The value used whenever the parameter is not overridden."
                },
                "constraints": {
                    "title": "String Parameter Constraints",
                    "type": "object",
                    "additionalProperties": false,
                    "description": "Optional restrictions the parameter value must satisfy. Length bounds and 'allowedValues' are mutually exclusive.",
                    "properties": {
                        "minLength": {
                            "type": "integer",
                            "minimum": 0,
                            "description": "The shortest accepted value length, inclusive."
                        },
                        "maxLength": {
                            "type": "integer",
                            "minimum": 0,
                            "description": "The longest accepted value length, inclusive."
                        },
                        "allowedValues": {
                            "type": "array",
                            "minItems": 1,
                            "description": "When present, the parameter value must equal one of the listed values.",
                            "items": {
                                "$ref": "#/$defs/parameterAllowedValue"
                            }
                        }
                    },
                    "not": {
                        "anyOf": [
                            {
                                "required": ["allowedValues", "minLength"]
                            },
                            {
                                "required": ["allowedValues", "maxLength"]
                            }
                        ]
                    }
                }
            },
            "required": ["type", "defaultValue"],
            "$semantic": {
                "type": "parameter_constraints"
            }
        },
        "parameterAllowedValue": {
            "title": "Parameter Allowed Value",
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "value": {
                    "type": "string",
                    "minLength": 1,
                    "description": "The accepted parameter value."
                },
                "title": {
                    "type": "string",
                    "description": "An optional human readable title shown instead of the raw value. Defaults to the value."
                }
            },
            "required": ["value"]
        }
    }
}
