{
    "name": "@gooddata/sdk-ui-analytical-designer",
    "version": "11.65.0-alpha.13",
    "description": "Analytical Designer UI library — core components, sagas, reducers, and application logic",
    "license": "LicenseRef-LICENSE",
    "author": {
        "name": "Stellar",
        "email": "stellar@gooddata.com"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/gooddata/gooddata-ui-sdk.git",
        "directory": "libs/sdk-ui-analytical-designer"
    },
    "files": [
        "esm/**/*.js",
        "esm/**/*.json",
        "esm/**/*.d.ts",
        "esm/**/*.map",
        "esm/**/*.svg",
        "esm/**/*.gif",
        "styles",
        "NOTICE"
    ],
    "type": "module",
    "sideEffects": [
        "*.css",
        "*.svg"
    ],
    "browser": "./esm/index.js",
    "types": "./esm/index.d.ts",
    "exports": {
        ".": "./esm/index.js",
        "./internal": "./esm/internal.js",
        "./styles/css/*": "./styles/css/*",
        "./styles/scss/*": "./styles/scss/*",
        "./styles/images/*": "./styles/images/*"
    },
    "scripts": {
        "_phase:build": "npm run build",
        "_phase:test": "npm run test-once",
        "_phase:validate": "npm run validate",
        "api-extractor": "mkdir -p api && [ -z \"${CI}\" ] && (api-extractor run -l; exit 0) || (api-extractor run)",
        "build": "bash scripts/build.sh",
        "build-check": "tsc",
        "build-ts": "tsc -p tsconfig.build.json",
        "clean": "../../common/scripts/clean-command-state.sh && rm -rf esm styles/css *.log",
        "format-check": "oxfmt --check .",
        "format-write": "oxfmt .",
        "lint": "oxlint . --quiet && eslint .",
        "lint-fix": "oxlint . --quiet --fix && eslint . --fix",
        "prepack": "cp -f ../../NOTICE ./NOTICE",
        "scss": "sass --load-path=node_modules styles/scss:styles/css",
        "stylelint": "stylelint 'styles/scss/**/*.scss'",
        "stylelint-fix": "stylelint 'styles/scss/**/*.scss' --fix",
        "test": "NODE_OPTIONS=--no-deprecation vitest",
        "test-once": "NODE_OPTIONS=--no-deprecation vitest run --silent=true --reporter=verbose",
        "validate": "npm run lint && npm run validate-dependencies && npm run stylelint && npm run format-check && npm run validate-locales && npm run validate-architecture",
        "validate-architecture": "node --import @oxc-node/core/register scripts/audit-state-architecture.ts --gate",
        "validate-dependencies": "dependency-cruise --validate -- src",
        "validate-esm": "node scripts/validate-esm.js",
        "validate-locales": "i18n-toolkit"
    },
    "dependencies": {
        "@evil-internetmann/react-dnd": "16.2.1",
        "@formatjs/intl-pluralrules": "1.5.9",
        "@gooddata/sdk-backend-base": "workspace:*",
        "@gooddata/sdk-backend-spi": "workspace:*",
        "@gooddata/sdk-backend-tiger": "workspace:*",
        "@gooddata/sdk-embedding": "workspace:*",
        "@gooddata/sdk-model": "workspace:*",
        "@gooddata/sdk-pluggable-application-model": "workspace:*",
        "@gooddata/sdk-ui": "workspace:*",
        "@gooddata/sdk-ui-ext": "workspace:*",
        "@gooddata/sdk-ui-filters": "workspace:*",
        "@gooddata/sdk-ui-kit": "workspace:*",
        "@gooddata/sdk-ui-metric-component": "workspace:*",
        "@gooddata/sdk-ui-pivot": "workspace:*",
        "@gooddata/sdk-ui-semantic-search": "workspace:*",
        "@gooddata/sdk-ui-theme-provider": "workspace:*",
        "@gooddata/util": "workspace:*",
        "@opentelemetry/api": "1.9.0",
        "@reduxjs/toolkit": "2.9.0",
        "classnames": "2.5.1",
        "dnd-core": "16.0.1",
        "http-status-codes": "2.1.4",
        "invariant": "2.2.2",
        "jquery": "3.7.1",
        "jquery.browser": "0.1.0",
        "json-stable-stringify": "1.3.0",
        "lodash-es": "^4.17.23",
        "moment": "^2.29.4",
        "pretty-bytes": "7.1.1",
        "query-string": "6.10.1",
        "react-intl": "10.1.25",
        "react-measure": "^2.5.2",
        "react-redux": "9.2.0",
        "react-router": "7.18.1",
        "react-virtualized": "9.22.6",
        "redux": "5.0.1",
        "redux-saga": "1.3.0",
        "reselect": "5.1.1",
        "rxjs": "6.6.7",
        "uuid": "11.1.1",
        "web-vitals": "3.5.2"
    },
    "devDependencies": {
        "@gooddata/eslint-config": "workspace:*",
        "@gooddata/i18n-toolkit": "workspace:*",
        "@gooddata/oxlint-config": "workspace:*",
        "@gooddata/sdk-backend-mockingbird": "workspace:*",
        "@gooddata/stylelint-config": "workspace:*",
        "@microsoft/api-extractor": "7.59.2",
        "@oxc-node/core": "0.1.3",
        "@redux-saga/testing-utils": "1.1.3",
        "@testing-library/jest-dom": "7.0.1",
        "@testing-library/react": "16.3.0",
        "@testing-library/user-event": "14.6.7",
        "@types/invariant": "2.2.37",
        "@types/jquery": "3.5.0",
        "@types/jquery.browser": "0.1.4",
        "@types/json-stable-stringify": "1.0.36",
        "@types/lodash-es": "4.17.12",
        "@types/node": "24.12.0",
        "@types/query-string": "6.3.0",
        "@types/react": "19.1.11",
        "@types/react-dom": "19.1.7",
        "@types/react-measure": "2.0.12",
        "@types/react-virtualized": "9.22.3",
        "@typescript-eslint/eslint-plugin": "8.58.0",
        "@typescript-eslint/parser": "8.58.0",
        "dependency-cruiser": "17.3.10",
        "eslint": "^9.39.2",
        "eslint-plugin-headers": "1.3.3",
        "eslint-plugin-jsdoc": "62.1.0",
        "eslint-plugin-no-barrel-files": "1.2.2",
        "eslint-plugin-no-only-tests": "3.3.0",
        "eslint-plugin-react": "7.37.5",
        "eslint-plugin-sonarjs": "3.0.6",
        "happy-dom": "20.12.0",
        "jiti": "2.6.1",
        "npm-run-all": "4.1.5",
        "oxfmt": "0.68.0",
        "oxlint": "1.83.0",
        "oxlint-plugin-eslint": "1.82.0",
        "oxlint-tsgolint": "7.0.2001",
        "react": "19.1.1",
        "react-dnd-test-backend": "16.0.1",
        "react-dom": "19.1.1",
        "redux-saga-test-plan": "4.0.6",
        "sass": "1.104.1",
        "stylelint": "16.26.1",
        "typescript": "7.0.2",
        "vitest": "5.0.4"
    },
    "peerDependencies": {
        "react": ">=18",
        "react-dom": ">=18"
    }
}
