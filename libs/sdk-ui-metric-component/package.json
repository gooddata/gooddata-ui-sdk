{
    "name": "@gooddata/sdk-ui-metric-component",
    "version": "11.66.0-alpha.0",
    "license": "LicenseRef-LICENSE",
    "author": "GoodData Corporation",
    "repository": {
        "type": "git",
        "url": "https://github.com/gooddata/gooddata-ui-sdk.git",
        "directory": "libs/sdk-ui-metric-component"
    },
    "files": [
        "esm",
        "worker/*.js",
        "NOTICE"
    ],
    "type": "module",
    "sideEffects": [
        "**/monacoContributions.js",
        "**/monacoWorkers.js"
    ],
    "browser": "./esm/index.js",
    "types": "./esm/index.d.ts",
    "exports": "./esm/index.js",
    "scripts": {
        "_phase:build": "npm run build",
        "_phase:test": "npm run test-once",
        "_phase:validate": "npm run validate",
        "api-extractor": "mkdir -p api && [ -z \"${CI}\" ] && (api-extractor run -l) || (api-extractor run)",
        "build": "npm run build-worker && npm-run-all -p build-check build-ts && npm run api-extractor",
        "build-check": "tsc",
        "build-ts": "tsc -p tsconfig.build.json",
        "build-worker": "rolldown node_modules/monaco-editor/esm/vs/editor/common/services/editorWebWorkerMain.js --format esm --platform browser --minify --file worker/monaco-editor-worker.js && node scripts/buildWorkerSource.js worker/monaco-editor-worker.js worker/monaco-editor-worker.source.js",
        "clean": "../../common/scripts/clean-command-state.sh && rm -rf dist worker *.log",
        "format-check": "oxfmt --check .",
        "format-write": "oxfmt .",
        "lint": "oxlint . --quiet && eslint .",
        "lint-fix": "oxlint . --quiet --fix && eslint . --fix",
        "prepack": "cp -f ../../NOTICE ./NOTICE",
        "test": "NODE_OPTIONS=--no-deprecation vitest",
        "test-once": "NODE_OPTIONS=--no-deprecation vitest run --silent=true",
        "validate": "npm run lint && npm run format-check && npm run validate-locales",
        "validate-esm": "node scripts/validate-esm.js",
        "validate-locales": "i18n-toolkit"
    },
    "dependencies": {
        "@emotion/react": "11.14.0",
        "@gooddata/api-client-tiger": "workspace:*",
        "@gooddata/sdk-backend-spi": "workspace:*",
        "@gooddata/sdk-backend-tiger": "workspace:*",
        "@gooddata/sdk-maql-language-server": "workspace:*",
        "@gooddata/sdk-model": "workspace:*",
        "@gooddata/sdk-ui": "workspace:*",
        "@gooddata/sdk-ui-charts": "workspace:*",
        "@gooddata/sdk-ui-ext": "workspace:*",
        "@gooddata/sdk-ui-kit": "workspace:*",
        "@gooddata/sdk-ui-pivot": "workspace:*",
        "@gooddata/util": "workspace:*",
        "classnames": "2.5.1",
        "lodash-es": "^4.17.23",
        "monaco-editor": "0.56.0",
        "react-intl": "10.1.25",
        "sql-formatter": "12.2.4",
        "tss-react": "4.9.19",
        "vscode-languageserver": "8.1.0",
        "vscode-languageserver-textdocument": "1.0.12",
        "vscode-languageserver-types": "3.17.5",
        "yup": "0.32.11"
    },
    "devDependencies": {
        "@gooddata/eslint-config": "workspace:*",
        "@gooddata/i18n-toolkit": "workspace:*",
        "@gooddata/oxlint-config": "workspace:*",
        "@gooddata/sdk-backend-base": "workspace:*",
        "@gooddata/sdk-ui-theme-provider": "workspace:*",
        "@microsoft/api-documenter": "7.30.16",
        "@microsoft/api-extractor": "7.59.2",
        "@testing-library/jest-dom": "7.0.1",
        "@testing-library/react": "16.3.0",
        "@types/lodash-es": "4.17.12",
        "@types/node": "24.12.0",
        "@types/react": "19.1.11",
        "@types/react-dom": "19.1.7",
        "@typescript-eslint/eslint-plugin": "8.58.0",
        "@typescript-eslint/parser": "8.58.0",
        "eslint": "^9.39.2",
        "eslint-plugin-headers": "1.3.3",
        "eslint-plugin-import-esm": "1.2.1",
        "eslint-plugin-jsdoc": "62.1.0",
        "eslint-plugin-no-barrel-files": "1.2.2",
        "eslint-plugin-no-only-tests": "3.3.0",
        "eslint-plugin-react": "7.37.5",
        "eslint-plugin-regexp": "1.15.0",
        "eslint-plugin-sonarjs": "3.0.6",
        "eslint-plugin-tsdoc": "0.2.14",
        "happy-dom": "20.12.0",
        "jiti": "2.6.1",
        "npm-run-all": "4.1.5",
        "oxfmt": "0.68.0",
        "oxlint": "1.83.0",
        "oxlint-plugin-eslint": "1.82.0",
        "oxlint-tsgolint": "7.0.2001",
        "react": "19.1.1",
        "react-dom": "19.1.1",
        "rolldown": "1.0.3",
        "typescript": "7.0.2",
        "vitest": "5.0.4"
    },
    "peerDependencies": {
        "react": "^18.0.0 || ^19.0.0",
        "react-dom": "^18.0.0 || ^19.0.0"
    }
}
