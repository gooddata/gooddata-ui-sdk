        "@gooddata/oxlint-config": "workspace:*",
        "@testing-library/dom": "10.4.2",
        "@testing-library/jest-dom": "7.0.1",
        "@testing-library/react": "16.3.0",
        "@types/lodash-es": "4.17.12",
        "@types/node": "24.12.0",
