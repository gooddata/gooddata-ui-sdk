{
    "name": "@gooddata/sdk-ui-metric-component",
    "version": "11.65.0-alpha.4",
    "license": "LicenseRef-LICENSE",
    "author": "GoodData Corporation",
    "repository": {
        "type": "git",
        "url": "https://github.com/gooddata/gooddata-ui-sdk.git",
        "directory": "libs/sdk-ui-metric-component"
    },
    "files": [
        "esm",
        "NOTICE"
    ],
    "type": "module",
    "sideEffects": [
        "**/monacoContributions.js",
        "**/monacoWorkers.js"
    ],
    "main": "esm/index.js",
    "types": "esm/index.d.ts",
    "scripts": {
        "_phase:build": "npm run build",
        "_phase:test": "npm run test-once",
        "_phase:validate": "npm run validate",
        "build": "bash scripts/build.sh",
        "build-check": "tsc -p tsconfig.check.json",
        "build-ts": "tsc -p tsconfig.build.json",
        "clean": "../../common/scripts/clean-command-state.sh && rm -rf dist *.log",
        "format-check": "oxfmt --check .",
        "format-write": "oxfmt .",
        "lint": "oxlint . --quiet && eslint .",
        "lint-fix": "oxlint . --quiet --fix && eslint . --fix",
        "prepack": "cp -f ../../NOTICE ./NOTICE",
        "test": "NODE_OPTIONS=--no-deprecation vitest",
        "test-once": "NODE_OPTIONS=--no-deprecation vitest run --silent=true",
        "validate": "npm run lint && npm run format-check && npm run validate-theming && npm run validate-locales",
        "validate-locales": "i18n-toolkit",
        "validate-theming": "node scripts/validateCss.mjs"
    },
    "dependencies": {
        "@emotion/react": "11.14.0",
        "@gooddata/api-client-tiger": "workspace:*",
