# Pre-reorg page URLs. Every reorganized page lists its old locations in
# `aliases` (page-relative — see STYLE_GUIDE.md). Hugo writes a meta-refresh
# HTML page at each alias path; a forced 301 here answers before that file is
# served, so the redirect is a real 301 and keeps its link equity.
# Resolved the way Hugo resolves a relative alias: against the directory the
# page is written into, which for a section index is the section's parent.
{{- $base := strings.TrimSuffix "/" (urls.Parse .Site.BaseURL).Path }}
{{- range .Site.Pages }}
{{- $target := .Permalink }}
{{- $dir := path.Dir (strings.TrimSuffix "/" (strings.TrimPrefix $base .RelPermalink)) }}
{{- range .Aliases }}
{{- $from := . }}
{{- if not (hasPrefix . "/") }}{{ $from = path.Join $dir . }}{{ end }}
{{ printf "%s/ %s 301!" (strings.TrimSuffix "/" $from) $target }}
{{- end }}
{{- end }}
