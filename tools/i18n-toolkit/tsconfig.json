{
    "extends": "../tsconfig.base.json",
    "include": ["src/**/*", "*.{ts,tsx}"],
    "compilerOptions": {
        "rootDir": "./",
        "noEmit": true,
        "skipLibCheck": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "useUnknownInCatchVariables": false,
        "strictNullChecks": false,
        "noImplicitAny": false
    }
}
