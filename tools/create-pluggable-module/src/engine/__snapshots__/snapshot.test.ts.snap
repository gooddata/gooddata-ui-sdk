  "module/src/HostUi.css": ".gdc-snap-host-ui {
    display: flex;
    flex-direction: column;
    height: 100vh;
    font-family: system-ui, sans-serif;
}

.gdc-snap-host-ui__header {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 16px;
    height: 48px;
    padding: 0 16px;
    background: var(--gdc-snap-host-ui-header-background, #000);
    color: var(--gdc-snap-host-ui-header-color, #fff);
}

.gdc-snap-host-ui__brand {
    font-weight: 700;
}

.gdc-snap-host-ui__nav {
    display: flex;
    flex: 1 1 auto;
    gap: 4px;
    overflow-x: auto;
}

.gdc-snap-host-ui__link {
    padding: 6px 10px;
    border-radius: 4px;
    color: inherit;
    text-decoration: none;
    white-space: nowrap;
}

.gdc-snap-host-ui__link:hover {
    background: rgb(255 255 255 / 16%);
}

.gdc-snap-host-ui__link--active {
    box-shadow: inset 0 -3px 0 var(--gdc-snap-host-ui-header-active, #14b2e2);
}

.gdc-snap-host-ui__button {
    padding: 4px 10px;
    border: 1px solid currentcolor;
    border-radius: 4px;
    background: transparent;
    color: inherit;
    cursor: pointer;
}

.gdc-snap-host-ui__button[aria-pressed="true"] {
    border-color: var(--gdc-snap-host-ui-header-active, #14b2e2);
}

.gdc-snap-host-ui__notification {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 16px;
    background: var(--gd-palette-complementary-2, #ebeff4);
    color: var(--gd-palette-complementary-9, #000);
}

.gdc-snap-host-ui__main {
    position: relative;
    flex: 1 1 auto;
    min-height: 0;
    overflow: auto;
}

.gdc-snap-host-ui__app {
    height: 100%;
}
",
  "module/src/HostUi.tsx": "// (C) 2026 GoodData Corporation

import {
    type CSSProperties,
    Component,
    type MouseEvent,
    type ReactNode,
    useEffect,
    useLayoutEffect,
    useRef,
} from "react";

import {
    type PluggableApplicationRegistryItem,
    getPluggableApplicationHref,
    getPluggableApplicationLocalizedTitle,
    isExternalPluggableApplicationRegistryItem,
} from "@gooddata/sdk-model";
import {
    type IAppHeaderOptions,
    type IHostUiNotification,
    type IPlatformContext,
} from "@gooddata/sdk-pluggable-application-model";

const BLOCK = "gdc-snap-host-ui";

export interface IHostUiState {
    ctx: IPlatformContext;
    applications: PluggableApplicationRegistryItem[];
    pathname: string;
    header: IAppHeaderOptions | undefined;
    pageTitle: string | undefined;
    chat: { showChatItem: boolean; isOpen: boolean };
    notification: IHostUiNotification | undefined;
}

export interface IHostUiProps {
    state: IHostUiState;
    appContainer: HTMLElement;
    navigate: (url: string) => void;
    onChatToggle?: () => void;
    onError?: (error: string, context: string) => void;
}

interface INavigationItem {
    id: string;
    title: string;
    href: string;
    isExternal: boolean;
    isActive: boolean;
}

const EMBEDDED_PREFIX = "/embedded";

export function getNavigationItems(
    applications: PluggableApplicationRegistryItem[],
    ctx: IPlatformContext,
    embeddedOrPlainPathname: string,
): INavigationItem[] {
    // Iframe routes repeat the regular routes under /embedded, and application hrefs never carry it.
    const pathname = embeddedOrPlainPathname.startsWith(\`\${EMBEDDED_PREFIX}/\`)
        ? embeddedOrPlainPathname.slice(EMBEDDED_PREFIX.length)
        : embeddedOrPlainPathname;
    return [...applications]
        .filter((app) => app.applicationScope !== "workspace" || ctx.currentWorkspaceId !== undefined)
        .sort((a, b) => a.menuOrder - b.menuOrder)
        .map((app) => {
            const href = getPluggableApplicationHref(app, ctx.currentWorkspaceId);
            const isExternal = isExternalPluggableApplicationRegistryItem(app);
            return {
                id: app.id,
                title: getPluggableApplicationLocalizedTitle(app, ctx.preferredLocale),
                href,
                isExternal,
                isActive: !isExternal && (pathname === href || pathname.startsWith(\`\${href}/\`)),
            };
        });
}

// The header colors of the organization theme, the same ones the default host header uses.
function getHeaderThemeStyle(ctx: IPlatformContext): CSSProperties {
    const header = ctx.theme?.header;
    return {
        ...(header?.backgroundColor ? { [\`--\${BLOCK}-header-background\`]: header.backgroundColor } : {}),
        ...(header?.color ? { [\`--\${BLOCK}-header-color\`]: header.color } : {}),
        ...(header?.activeColor ? { [\`--\${BLOCK}-header-active\`]: header.activeColor } : {}),
    } as CSSProperties;
}

export function HostUi({ state, appContainer, navigate, onChatToggle, onError }: IHostUiProps) {
    const { ctx, applications, pathname, header, pageTitle, chat, notification } = state;
    const items = getNavigationItems(applications, ctx, pathname);
    const brand = ctx.organization?.title ?? ctx.organization?.id ?? "Snapshot Host UI";
    const documentTitle = pageTitle ?? items.find((item) => item.isActive)?.title;
    const isHeaderHidden = ctx.embeddingMode === "iframe" || ctx.isExportMode === true;

    useEffect(() => {
        // Exports print the document title, so it carries no brand there, as in the default host header.
        if (ctx.isExportMode) {
            document.title = documentTitle ?? "";
            return;
        }
        document.title = documentTitle ? \`\${documentTitle} - \${brand}\` : brand;
    }, [documentTitle, brand, ctx.isExportMode]);

    return (
        <div className={BLOCK} style={getHeaderThemeStyle(ctx)}>
            {isHeaderHidden ? null : (
                // The pathname key resets a failed header when the user moves to another page.
                <HostUiErrorBoundary key={pathname} onError={onError}>
                    <HostHeader
                        brand={brand}
                        items={items}
                        login={ctx.user.login}
                        header={header}
                        chat={chat}
                        notification={notification}
                        navigate={navigate}
                        onChatToggle={onChatToggle}
                    />
                </HostUiErrorBoundary>
            )}
            <AppSlot appContainer={appContainer} />
        </div>
    );
}

interface IHostHeaderProps {
    brand: string;
    items: INavigationItem[];
    login: string;
    header: IAppHeaderOptions | undefined;
    chat: IHostUiState["chat"];
    notification: IHostUiNotification | undefined;
    navigate: (url: string) => void;
    onChatToggle?: () => void;
}

function HostHeader({
    brand,
    items,
    login,
    header,
    chat,
    notification,
    navigate,
    onChatToggle,
}: IHostHeaderProps) {
    const onLinkClick = (event: MouseEvent<HTMLAnchorElement>, item: INavigationItem) => {
        if (item.isExternal || event.metaKey || event.ctrlKey || event.shiftKey || event.button !== 0) {
            return;
        }
        event.preventDefault();
        navigate(item.href);
    };

    return (
        <>
            <header className={\`\${BLOCK}__header\`}>
                <span className={\`\${BLOCK}__brand\`}>{brand}</span>
                <nav className={\`\${BLOCK}__nav\`}>
                    {items.map((item) => (
                        <a
                            key={item.id}
                            href={item.href}
                            className={
                                item.isActive ? \`\${BLOCK}__link \${BLOCK}__link--active\` : \`\${BLOCK}__link\`
                            }
                            aria-current={item.isActive ? "page" : undefined}
                            onClick={(event) => onLinkClick(event, item)}
                        >
                            {item.title}
                        </a>
                    ))}
                </nav>
                {header?.helpMenuItems?.map((helpItem) =>
                    helpItem.href ? (
                        <a
                            key={helpItem.key}
                            href={helpItem.href}
                            target={helpItem.target ?? "_blank"}
                            rel="noopener noreferrer"
                            className={\`\${BLOCK}__link\`}
                        >
                            {helpItem.label ?? helpItem.key}
                        </a>
                    ) : null,
                )}
                {chat.showChatItem ? (
                    <button
                        type="button"
                        className={\`\${BLOCK}__button\`}
                        aria-pressed={chat.isOpen}
                        onClick={onChatToggle}
                    >
                        AI assistant
                    </button>
                ) : null}
                <span className={\`\${BLOCK}__user\`}>{login}</span>
            </header>
            {notification?.type === "newDeploymentAvailable" ? (
                <div className={\`\${BLOCK}__notification\`} role="status">
                    A new version is available.
                    <button
                        type="button"
                        className={\`\${BLOCK}__button\`}
                        onClick={() => window.location.reload()}
                    >
                        Reload
                    </button>
                </div>
            ) : null}
        </>
    );
}

function AppSlot({ appContainer }: { appContainer: HTMLElement }) {
    const slotRef = useRef<HTMLDivElement>(null);

    useLayoutEffect(() => {
        slotRef.current?.appendChild(appContainer);
    }, [appContainer]);

    return <main ref={slotRef} className={\`\${BLOCK}__main\`} />;
}

interface IHostUiErrorBoundaryProps {
    onError?: (error: string, context: string) => void;
    children: ReactNode;
}

// The host UI renders in its own React root, so the host error boundary does not see its errors.
class HostUiErrorBoundary extends Component<IHostUiErrorBoundaryProps, { hasError: boolean }> {
    override state = { hasError: false };

    static getDerivedStateFromError() {
        return { hasError: true };
    }

    override componentDidCatch(error: Error) {
        this.props.onError?.(error.message, "gdc-snap-host-ui");
    }

    override render() {
        return this.state.hasError ? (
            <p role="alert">The application header failed to load.</p>
        ) : (
            this.props.children
        );
    }
}
",
  "module/src/hostUiModule.test.tsx": "// (C) 2026 GoodData Corporation

import { act } from "react";

import { afterEach, describe, expect, it, vi } from "vitest";

import { type PluggableApplicationRegistryItem } from "@gooddata/sdk-model";
import {
    type IHostUiMountHandle,
    type IHostUiMountOptions,
    type IPlatformContext,
} from "@gooddata/sdk-pluggable-application-model";

import { getNavigationItems } from "./HostUi.js";
import { hostUiModule } from "./hostUiModule.js";

// React warns when act() runs outside a test environment that declares it.
(globalThis as { IS_REACT_ACT_ENVIRONMENT?: boolean }).IS_REACT_ACT_ENVIRONMENT = true;

const ctx = {
    user: { login: "user@example.com" },
    organization: { id: "org-1", title: "Example organization" },
    currentWorkspaceId: "ws-1",
} as IPlatformContext;

const applications: PluggableApplicationRegistryItem[] = [
    {
        apiVersion: "1.0",
        id: "workspace-app",
        applicationScope: "workspace",
        menuOrder: 2,
        title: "Workspace app",
        local: { routeBase: "/workspace-app" },
    },
    {
        apiVersion: "1.0",
        id: "organization-app",
        applicationScope: "organization",
        menuOrder: 1,
        title: "Organization app",
        local: { routeBase: "/organization-app" },
    },
];

let container: HTMLElement;
let handle: IHostUiMountHandle | undefined;

function mount(overrides: Partial<IHostUiMountOptions> = {}) {
    container = document.createElement("div");
    document.body.appendChild(container);
    act(() => {
        handle = hostUiModule.mount({
            container,
            ctx,
            resolvedApplications: applications,
            pathname: "/organization/organization-app",
            navigate: vi.fn(),
            replace: vi.fn(),
            ...overrides,
        });
    });
    return handle!;
}

describe("hostUiModule", () => {
    afterEach(() => {
        act(() => handle?.unmount());
        handle = undefined;
        container.remove();
    });

    it("returns the app container synchronously and places it in the layout", () => {
        const mounted = mount();

        expect(container.contains(mounted.getAppContainer())).toBe(true);
    });

    it("navigates through the host on a menu click", () => {
        const navigate = vi.fn();
        mount({ navigate });

        act(() => {
            container.querySelector<HTMLAnchorElement>('a[href="/workspace/ws-1/workspace-app"]')!.click();
        });

        expect(navigate).toHaveBeenCalledWith("/workspace/ws-1/workspace-app");
    });

    it("moves the active item when the host pushes a new pathname", () => {
        const mounted = mount();

        act(() => mounted.updatePathname?.("/workspace/ws-1/workspace-app/detail"));

        expect(container.querySelector('[aria-current="page"]')?.textContent).toBe("Workspace app");
    });

    it("keeps the application container when the header fails to render", () => {
        vi.spyOn(console, "error").mockImplementation(() => {});
        const onError = vi.fn();
        const mounted = mount({ onError });
        const brokenItem = {
            key: "broken",
            href: "https://example.com",
            get label(): string {
                throw new Error("broken label");
            },
        };

        act(() => mounted.updateHeader?.({ helpMenuItems: [brokenItem] }));

        expect(container.querySelector("header")).toBeNull();
        expect(container.querySelector('[role="alert"]')).not.toBeNull();
        expect(container.contains(mounted.getAppContainer())).toBe(true);
        expect(onError).toHaveBeenCalledWith("broken label", "gdc-snap-host-ui");

        act(() => {
            mounted.updateHeader?.(undefined);
            mounted.updatePathname?.("/workspace/ws-1/workspace-app");
        });

        expect(container.querySelector("header")).not.toBeNull();
    });

    it("renders only the application container in the export mode", () => {
        const mounted = mount({ ctx: { ...ctx, isExportMode: true } });

        expect(document.title).toBe("Organization app");
        act(() => mounted.notify?.({ type: "newDeploymentAvailable", commitHash: "abc" }));

        expect(container.querySelector("header")).toBeNull();
        expect(container.querySelector('[role="status"]')).toBeNull();
        expect(container.contains(mounted.getAppContainer())).toBe(true);
    });
});

describe("hostUiModule theme", () => {
    it("applies the header colors of the organization theme", () => {
        const themed = document.createElement("div");
        let themedHandle: IHostUiMountHandle | undefined;
        act(() => {
            themedHandle = hostUiModule.mount({
                container: themed,
                ctx: { ...ctx, theme: { header: { backgroundColor: "#123456" } } },
                resolvedApplications: [],
                pathname: "/",
                navigate: vi.fn(),
                replace: vi.fn(),
            });
        });

        const root = themed.firstElementChild as HTMLElement;
        expect(root.style.getPropertyValue("--gdc-snap-host-ui-header-background")).toBe("#123456");
        act(() => themedHandle?.unmount());
    });
});

describe("hostUiModule metadata", () => {
    it("carries the build metadata that the host checks for a secured remote", () => {
        expect(hostUiModule.allowedOrganizations).toEqual([]);
        expect(hostUiModule.buildTimestamp).toBe(0);
    });
});

describe("getNavigationItems", () => {
    it("sorts by menu order and hides workspace apps outside a workspace", () => {
        const items = getNavigationItems(applications, { ...ctx, currentWorkspaceId: undefined }, "/");

        expect(items.map((item) => item.id)).toEqual(["organization-app"]);
    });

    it("marks the active application on an embedded route", () => {
        const items = getNavigationItems(applications, ctx, "/embedded/workspace/ws-1/workspace-app");

        expect(items.find((item) => item.isActive)?.id).toBe("workspace-app");
    });
});
",
  "module/src/hostUiModule.tsx": "// (C) 2026 GoodData Corporation

import { type Root, createRoot } from "react-dom/client";

import {
    type IHostUiModule,
    type IHostUiMountHandle,
    type IHostUiMountOptions,
} from "@gooddata/sdk-pluggable-application-model";

import { HostUi, type IHostUiState } from "./HostUi.js";
import "./HostUi.css";

// vite.config.ts and vitest.config.ts define both values at build time.
declare const __BUILD_TIMESTAMP__: number;
declare const __ALLOWED_ORGANIZATIONS__: string[];

function mountHostUi({
    container,
    ctx,
    resolvedApplications,
    pathname,
    navigate,
    onChatToggleRequested,
    onError,
}: IHostUiMountOptions): IHostUiMountHandle {
    // The host calls getAppContainer() immediately after mount() returns, before React commits.
    // Create the element here and let HostUi move it into its layout.
    const appContainer = document.createElement("div");
    appContainer.className = "gdc-snap-host-ui__app";

    let root: Root | undefined = createRoot(container);
    let state: IHostUiState = {
        ctx,
        applications: resolvedApplications,
        pathname,
        header: undefined,
        pageTitle: undefined,
        chat: { showChatItem: false, isOpen: false },
        notification: undefined,
    };

    const render = () => {
        root?.render(
            <HostUi
                state={state}
                appContainer={appContainer}
                navigate={navigate}
                onChatToggle={onChatToggleRequested}
                onError={onError}
            />,
        );
    };

    const update = (patch: Partial<IHostUiState>) => {
        state = { ...state, ...patch };
        render();
    };

    render();

    return {
        unmount() {
            root?.unmount();
            root = undefined;
        },
        updateContext: (nextCtx) => update({ ctx: nextCtx }),
        updateApplications: (applications) => update({ applications }),
        updatePathname: (nextPathname) => update({ pathname: nextPathname }),
        updateHeader: (header) => update({ header }),
        updateDocumentTitle: (pageTitle) => update({ pageTitle }),
        updateChatState: (chat) => update({ chat }),
        notify: (notification) => update({ notification }),
        getAppContainer: () => appContainer,
    };
}

export const hostUiModule: IHostUiModule = {
    allowedOrganizations: __ALLOWED_ORGANIZATIONS__,
    buildTimestamp: __BUILD_TIMESTAMP__,
    mount: mountHostUi,
};
",
